{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FrontendBucketWrite",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::vetpath-frontend-600406561374",
        "arn:aws:s3:::vetpath-frontend-600406561374/*"
      ]
    },
    {
      "Sid": "FrontendCacheInvalidation",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::600406561374:distribution/E13O5U324HB46D"
    }
  ]
}
