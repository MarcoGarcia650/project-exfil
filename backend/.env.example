DATABASE_URL="postgresql://user:password@localhost:5432/vetpath?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-real-secret"
# Base URL used in password-reset links printed by `npm run reset-link`.
FRONTEND_URL="http://localhost:5173"
