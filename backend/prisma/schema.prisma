// Project Exfil data model.
//
// Shape (see research/SCHEMA_PROPOSAL.md for the reasoning):
//   Organization 1─* Program          — one org can run several programs/designated roles
//   User 1─* SavedEmployer *─1 Program — a user's tracked listing (+ ActionItems)
//   Program 1─* Comment (threaded)     — public, timestamped discussion
//   Comment 1─* Report, Program 1─* Submission — reactive moderation + user leads
//
// Migration status: expand → backfill → switch → contract is complete.
// The legacy `Employer` table and `SavedEmployer.employerId` were dropped
// in the contract migration (after every saved row pointed at a Program).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Users ───────────────────────────────

enum Branch {
  ARMY
  NAVY
  AIR_FORCE
  MARINES
  COAST_GUARD
  SPACE_FORCE
  MILITARY_SPOUSE
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique // private; never shown publicly
  passwordHash   String
  branch         Branch
  targetField    String?
  separationDate DateTime?
  createdAt      DateTime  @default(now())

  // Public identity. `username` is stored as typed; `usernameKey` is its
  // lowercase form and carries the unique constraint, so "Marco" and
  // "marco" can't both exist. Null until chosen (legacy accounts) —
  // required before posting a comment.
  username    String?
  usernameKey String? @unique

  role         Role      @default(USER)
  suspendedAt  DateTime? // non-null = read-only account
  tokenVersion Int       @default(0) // bumped on password reset to invalidate old JWTs

  savedEmployers   SavedEmployer[]
  comments         Comment[]
  reports          Report[]
  submissions      Submission[]
  reviewedPrograms Program[]            @relation("ProgramReviewer")
  resetTokens      PasswordResetToken[] @relation("ResetTokenOwner")
  issuedResetTokens PasswordResetToken[] @relation("ResetTokenIssuer")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ResetTokenOwner", fields: [userId], references: [id])
  tokenHash   String    @unique // only a SHA-256 hash is stored; the raw token lives in the link
  expiresAt   DateTime
  usedAt      DateTime? // single use
  createdById String? // admin who issued it; null later for self-serve email resets
  createdBy   User?     @relation("ResetTokenIssuer", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// ───────────────────────────── Directory ─────────────────────────────

model Organization {
  id         String    @id @default(cuid())
  slug       String    @unique // "amazon" — stable URL + import key
  name       String
  websiteUrl String?
  programs   Program[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum ProgramFormat {
  TRAINING
  CERTIFICATION_TRAINING
  FELLOWSHIP
  INTERNSHIP
  APPRENTICESHIP
  DIRECT_HIRE
}

enum TechTrack {
  SOFTWARE_DEV
  IT_SUPPORT
  CLOUD
  CYBERSECURITY
  DATA
}

// Is the LISTING shown? (our decision)
enum PublishStatus {
  DRAFT // imported, awaiting review in the admin page — never public
  PUBLISHED
  ARCHIVED // readable at its URL with archiveReason; hidden from browse
  REJECTED // failed admin review — never public; a re-import with changed content returns it to DRAFT
}

// Can someone APPLY right now? (the provider's state, as of verifiedOn)
enum ApplicationAvailability {
  ACCEPTING
  ROLLING
  CLOSED
  UNKNOWN
}

model Program {
  id             String       @id @default(cuid())
  slug           String       @unique // = staging id; URL is /programs/:slug
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name               String
  description        String
  format             ProgramFormat
  techTracks         TechTrack[]
  // Display text only — NOT proof of verification. Verification is
  // guaranteed by the review gate (validator → DRAFT import → admin
  // Approve & publish), never by this column existing.
  veteranAccessRoute String
  eligibilityNotes   String? // null = unknown → UI shows "Not stated by provider"
  prerequisites      String?
  remoteAvailability String? // "remote" | "in_person" | "hybrid" | "varies"
  locations          String[]
  cost               String?
  duration           String?

  applicationAvailability ApplicationAvailability @default(UNKNOWN)
  applicationTiming       String?
  applicationUrl          String?
  officialSourceUrl       String
  skillbridgeNote         String?

  verifiedOn DateTime // shown on the listing

  // True for a DRAFT whose content did NOT come from a SOURCE_VERIFIED
  // staging record (the legacy backfill's oracle-ovip). The admin page
  // lists it but refuses Approve & publish. The importer clears it whenever
  // it writes verified content.
  awaitingResearch Boolean @default(false)

  publishStatus PublishStatus @default(DRAFT)
  archivedAt    DateTime?
  archiveReason String? // user-facing; required when ARCHIVED (enforced by importer)

  // Set when the admin rejects a DRAFT. Admin-only; never sent publicly.
  rejectedAt      DateTime?
  rejectionReason String?

  // Review metadata describes exactly what was reviewed: a PUBLISHED row
  // always has reviewedContentHash == contentHash. A content change sends
  // the row back to DRAFT and clears these (see import-programs.js).
  contentHash         String
  reviewedContentHash String?
  reviewedById        String?
  reviewedBy          User?     @relation("ProgramReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?

  savedBy     SavedEmployer[]
  comments    Comment[]
  submissions Submission[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([publishStatus])
}

// LEGACY — replaced by Organization/Program. Kept until the contract step.


// ───────────────────────── Tracking (per user) ─────────────────────────

enum Status {
  RESEARCHING
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

// A user's tracked listing (one Program). The table keeps its original
// name to avoid a rename; every row points at a Program.
model SavedEmployer {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  programId   String
  program     Program      @relation(fields: [programId], references: [id])
  status      Status
  notes       String?
  savedAt     DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  actionItems ActionItem[]

  // One tracked row per user per listing.
  @@unique([userId, programId])
}

model ActionItem {
  id              String        @id @default(cuid())
  savedEmployerId String
  savedEmployer   SavedEmployer @relation(fields: [savedEmployerId], references: [id])
  title           String
  completed       Boolean       @default(false)
  order           Int
  createdAt       DateTime      @default(now())
}

// ───────────────────────────── Community ─────────────────────────────

model Comment {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])

  // Threading. Same-program replies and "no new replies to hidden
  // comments" are enforced in the controller — the DB can't express them.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  body         String // 1–2,000 chars, enforced in code
  createdAt    DateTime  @default(now()) // shown on every comment
  hiddenAt     DateTime? // shown as "Removed by admin"; replies stay visible
  hiddenReason String? // admin-only
  reports      Report[]

  @@index([programId, parentId, createdAt, id])
  @@index([authorId, createdAt]) // posting rate limit: "my recent comments"
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  commentId  String
  comment    Comment      @relation(fields: [commentId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
}

enum SubmissionKind {
  LISTING_UPDATE
  NEW_LISTING_LEAD
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A lead, never evidence: accepting it only marks it reviewed. The listing
// change itself still goes staging → validator → import → Approve & publish.
model Submission {
  id          String           @id @default(cuid())
  kind        SubmissionKind
  programId   String? // required for LISTING_UPDATE (enforced in code)
  program     Program?         @relation(fields: [programId], references: [id])
  submitterId String
  submitter   User             @relation(fields: [submitterId], references: [id])
  body        String
  sourceUrl   String?
  status      SubmissionStatus @default(PENDING)
  adminNote   String? // shown to the submitter
  createdAt   DateTime         @default(now())
  reviewedAt  DateTime?

  @@index([status, createdAt])
  @@index([submitterId, createdAt])
}
