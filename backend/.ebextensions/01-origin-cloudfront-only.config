# Only CloudFront may reach this instance on port 80.
#
# Why: the API is served via CloudFront (api.projectexfilout.org →
# distribution E9MINVBK7U0GY → this EB environment over HTTP:80). With the
# EB default rule (0.0.0.0/0 on port 80) anyone could call the
# *.elasticbeanstalk.com origin directly, fake X-Forwarded-For and dodge the
# per-IP rate limits (TRUST_PROXY=2 trusts two proxy hops).
#
# How: overrides the ingress of the security group EB itself creates
# (CloudFormation logical ID AWSEBSecurityGroup) instead of editing it in
# the console, so EB/CloudFormation won't drift it back. The source is the
# AWS-managed prefix list of CloudFront origin-facing addresses (kept up to
# date by AWS; counts as ~55 of the group's 60-rule quota).
#
# Removing this file and redeploying restores EB's default (0.0.0.0/0).
Resources:
  AWSEBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          SourcePrefixListId: pl-3b927c52
          Description: CloudFront origin-facing only
